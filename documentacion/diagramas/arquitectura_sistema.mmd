graph TD
    subgraph "Aplicación Multiplataforma - Frontend"
        A[Aplicación Flutter]
    end

    subgraph "Plataformas de Despliegue"
        M[Web - genera HTML, JS, y todo lo necesario para ejecutarse detrás de un servidor web, en este caso Nginx]
        N[Android - Hace un build y genera un .apk]
        O[Desktop Linux - Genera un .deb que puede ser instalado en distribuciones Ubuntu y Debian]
    end

    subgraph "Backend"
        B[FastAPI]
        C[SQLAlchemy ORM]
        D[SQLite Database]
        E["API (Gestión de datos, Lógica de negocio, Autenticación)"]
        B -- "Gestiona Datos vía" --> C
        C -- "Accede a" --> D
        B -- "Implementa" --> E
    end

    subgraph "Servicio de IA"
        F[Ollama]
        G["Modelo LLM (granite3.3:2b)"]
        F -- "Sirve" --> G
    end

    subgraph "CI / CD"
        H["Repositorio en GitLab"]
        I[GitLab CI/CD]
        J["Tests, Build & Push <br> (stages no activas)"]
        CR["Container Registry (Docker Hub)"]
        L["Desplegar aplicación <br> (stage activa)"]
        H -- "on push" --> I
        I -- "triggers" --> J
        J -- "hace push a" --> CR
        I -- "triggers" --> L
        L -- "hace pull desde" --> CR
    end

    A -- "Llamadas API Autenticadas" --> B
    B -- "Consulta al LLM" --> F
    A -- "Se despliega como" --> M
    A -- "Se despliega como" --> N
    A -- "Se despliega como" --> O
    L -- "Despliega Frontend" --> A
    L -- "Despliega Backend" --> B
    L -- "Despliega y configura" --> F

    classDef frontend fill:#f9f,stroke:#333,stroke-width:2px
    classDef backend fill:#ccf,stroke:#333,stroke-width:2px
    classDef ai fill:#cfc,stroke:#333,stroke-width:2px
    classDef devops fill:#fcf,stroke:#333,stroke-width:2px
    classDef deployment fill:#f9c,stroke:#333,stroke-width:2px

    class A frontend
    class B,C,D,E backend
    class F,G ai
    class H,I,J,L,CR devops
    class M,N,O deployment
