graph TD
    subgraph "Flujo de Entrada"
        A("fa:fa-rocket Splash Screen")
        B("fa:fa-sign-in-alt Autenticación (Login / Registro)")
    end

    subgraph "Aplicación Principal (Navegación)"
        C{"fa:fa-home Home"}
        D["fa:fa-language Selección de Idioma"]
        E["fa:fa-book-open Centro de Aprendizaje"]
        F["fa:fa-user-cog Perfil de Usuario"]
    end

    subgraph "Centro de Aprendizaje (Detalle)"
        E1["fa:fa-list-ul Lista de Cursos"]
        E2["fa:fa-layer-group Unidades del Curso"]
        E3["fa:fa-puzzle-piece Ejercicios de la Unidad"]
    end

    subgraph "Herramientas de IA (Integradas en Ejercicios)"
        G["fa:fa-comments Chat con IA"]
        H["fa:fa-exchange-alt Traducción"]
        I["fa:fa-info-circle Explicación Gramatical"]
    end

    %% Conexiones de Flujo
    A -- "Carga inicial" --> B
    B -- "Login Exitoso" --> C
    
    C -- "Navegación" --> D
    C -- "Navegación" --> E
    C -- "Navegación" --> F
    C -- "Accede a" --> G
    C -- "Accede a" --> H

    D -- "Idioma seleccionado" --> E

    E -- "Seleccionar Curso" --> E1
    E1 -- "Seleccionar Unidad" --> E2
    E2 -- "Iniciar Ejercicio" --> E3
    E2 -- "Generar Ejercicios" --> E4("fa:fa-magic Ejercicios con IA")
    
    E3 -- "Accede a" --> G
    E3 -- "Accede a" --> H
    E3 -- "Accede a" --> I

    F -- "Guardar cambios" --> C

    %% Estilos
    classDef entry fill:#f9f,stroke:#333,stroke-width:2px
    classDef main fill:#ccf,stroke:#333,stroke-width:2px
    classDef feature fill:#e6f3ff,stroke:#333,stroke-width:2px
    classDef ai fill:#cfc,stroke:#333,stroke-width:2px

    class A,B entry
    class C,D,E,F main
    class E1,E2,E3 feature
    class G,H,I ai
